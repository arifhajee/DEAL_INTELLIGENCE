# =============================================================================
# DEAL_INTEL: Centralized Deployment Configuration
# =============================================================================
# Single source of truth for all deployment variables.
# Used by: deploy.sh, undeploy.sh, and the app (.env generation).
#
# IMPORTANT: SQL scripts in sql/ use these same values as hardcoded literals.
# If you change values here, update the corresponding SQL files to match.
#
# To customize for your environment, modify values below before running deploy.
# =============================================================================

# --- Databases ---
DEAL_INTEL_DATABASE=DEAL_INTEL
DEAL_INTEL_DATA_SCHEMA=DATA
DEAL_INTEL_SERVICES_SCHEMA=SERVICES
DEAL_INTEL_APP_SCHEMA=APP_SERVICE

# --- Warehouses ---
DEAL_INTEL_QUERY_WH=DEAL_INTEL_QUERY_WH
DEAL_INTEL_PIPELINE_WH=DEAL_INTEL_WH

# --- Compute ---
DEAL_INTEL_COMPUTE_POOL=DEAL_INTEL_POOL

# --- Roles ---
DEAL_INTEL_ADMIN_ROLE=DEAL_INTEL_ADMIN
DEAL_INTEL_USER_ROLE=DEAL_INTEL_USER
DEAL_INTEL_PIPELINE_ROLE=DEAL_INTEL_PIPELINE

# --- Default User (granted all roles during deploy) ---
# IMPORTANT: Change this to your Snowflake username before deploying
DEAL_INTEL_DEFAULT_USER=JOHN

# --- Integration ---
DEAL_INTEL_EAI=DEAL_INTEL_EGRESS_EAI
DEAL_INTEL_NETWORK_RULE=DEAL_INTEL_EGRESS_RULE

# --- App ---
DEAL_INTEL_APP_NAME=DEAL_INTEL_APP
DEAL_INTEL_SEARCH_SVC=deal_search_svc
DEAL_INTEL_CORTEX_MODEL=claude-sonnet-4-5
DEAL_INTEL_STAGE=deal_documents_stage
DEAL_INTEL_AGENT_NAME=deal_intelligence_agent

SNOWFLAKE_DEFAULT_CONNECTION_NAME=ahajee-demo
